# Ambil dari Neon dashboard -> Connection Details -> "Pooled connection"
# Contoh: postgresql://neondb_owner:xxxxx@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

PORT=10000
NODE_ENV=development

# Login dashboard (satu username+password bersama untuk seluruh tim)
APP_USERNAME=
APP_PASSWORD=
# String acak panjang untuk enkripsi cookie session — ganti dengan nilai unik di produksi
# (contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
